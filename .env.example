# =============================================================================
# Copie ce fichier : renomme la copie en ".env" (à la racine du projet,
# à côté de package.json). Remplis les valeurs. Ne commite jamais le vrai .env.
# =============================================================================

# --- Supabase (obligatoire pour l’app) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'app pour les redirections d'auth (prod)
# Exemple: https://tanstack-start-ts.npaysant.workers.dev
VITE_PUBLIC_APP_URL=
# Pour scripts import / admin serveur uniquement (jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Générateur de questions (admin) — au moins UNE des options A, B ou C
# Ce sont des « variables d’environnement » : NOM=valeur, lues au démarrage
# du serveur (npm run dev / déploiement). Ce n’est pas un réglage dans l’UI.
# =============================================================================

# --- Option A — OpenAI (recommandé) ---
# Clé du type sk-... : https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modèle (optionnel, défaut gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# URL de base (optionnel ; Azure / proxy : mets l’URL …/v1 fournie par ton hébergeur)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B — Autre API « compatible OpenAI » (Groq, OpenRouter, etc.) ---
# AI_API_KEY=
# Exemple Groq : https://api.groq.com/openai/v1
# AI_API_BASE_URL=
# AI_MODEL=

# --- Option C — Repli passerelle Lovable (si tu l’utilises encore) ---
# LOVABLE_API_KEY=
